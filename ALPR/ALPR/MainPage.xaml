<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ALPR.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30,0">

            <Label Text="Tesseract OCR for MAUI" 
                   FontSize="24" 
                   HorizontalOptions="Center" />

            <Button Text="Pick Image" 
                    Clicked="OnPickImageClicked"
                    HorizontalOptions="Center" />

            <Button Text="Take Photo" 
                    Clicked="OnTakePhotoClicked"
                    HorizontalOptions="Center" />

            <Image x:Name="SelectedImage"
                   HeightRequest="300"
                   Aspect="AspectFit" />

            <Button Text="Extract Text" 
                    Clicked="OnExtractTextClicked"
                    HorizontalOptions="Center" />

            <Label x:Name="StatusLabel" 
                   Text="Ready..."
                   FontSize="14" />

            <ScrollView HeightRequest="200">
                <Label x:Name="ResultLabel" 
                       FontSize="12" />
            </ScrollView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
